                "items": [
                    {
                        "uuid": "19c41d0744c24960beeba2953c84e38c",
                        "name": "Intel(R) C600+/220+ RAW data",
                        "key": "vfs.file.contents[C:\\scripts\\raid.txt]",
                        "delay": "10m",
                        "history": "0",
                        "value_type": "TEXT",
                        "trends": "0",
                        "preprocessing": [
                            {
                                "type": "JAVASCRIPT",
                                "parameters": [
                                    "var volumes = [];\nvar currentVolume = null;\nvar currentDisk = null;\nvar mode = null;\n\nvar lines = value.split(\"\\n\");\n\nfor (var i = 0; i < lines.length; i++) {\n    lines[i] = lines[i].trim();\n    if (!lines[i]) continue;\n    \n    \n    if (lines[i].indexOf(\"--VOLUME INFORMATION--\") === 0) {\n        if (currentVolume) volumes.push(currentVolume);\n        currentVolume = { disks: [] };\n        mode = \"volume\";\n    }\n\n    if (lines[i].indexOf(\"--DISKS IN VOLUME\") === 0) {\n        mode = \"disks\";\n        currentDisk = null;\n    }\n\n    if (lines[i].indexOf(\"ID:\") === 0) {\n        if (mode === \"disks\") {\n            currentDisk = {};\n            currentVolume.disks.push(currentDisk);\n            currentDisk.id = lines[i].split(\":\")[1].trim();\n        }\n    }\n\n    if (mode === \"volume\" && lines[i].indexOf(\":\") !== -1 && lines[i].indexOf(\"--\") !== 0) {\n        var idx = lines[i].indexOf(\":\");\n        var key = lines[i].substring(0, idx).trim().toLowerCase().replace(/\\s+/g, \"_\");\n        var val = lines[i].substring(idx + 1).trim();\n         currentVolume[key] = val;\n    }   \n    if (mode === \"disks\" && currentDisk && lines[i].indexOf(\":\") !== -1 && lines[i].indexOf(\"--\") !== 0)\n    {\n        var idx = lines[i].indexOf(\":\");\n        var key = lines[i].substring(0, idx).trim().toLowerCase().replace(/\\s+/g, \"_\");\n        var val = lines[i].substring(idx + 1).trim();\n        currentDisk[key] = val;\n        currentDisk.volume = currentVolume.name; // \u0412\u0410\u0416\u041d\u041e\n    }\n}\nif (currentVolume)volumes.push(currentVolume);\nreturn JSON.stringify({ volumes: volumes });"
                                ]
                            }
                        ],
                        "tags": [
                            {
                                "tag": "component",
                                "value": "raid"
                            },
                            {
                                "tag": "controller",
                                "value": "c600-220"
                            }
                        ]
                    }
